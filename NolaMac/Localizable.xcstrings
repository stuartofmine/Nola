        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Операция с аккаунтом не подтверждена. Проверьте аккаунты этого Mac перед повторным началом. Генерация не запрашивалась."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
