          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ask a question, open a workspace, or bring in a document."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haz una pregunta, abre un espacio de trabajo o añade un documento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Posez une question, ouvrez un espace de travail ou ajoutez un document."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "質問する、ワークスペースを開く、または書類を追加します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
