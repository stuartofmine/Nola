    "mac.startup.failure.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nola kann keine Verbindung zum Anwendungsdienst herstellen. Versuche es erneut oder öffne die Details zur Fehlerdiagnose."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nola could not connect to its application service. Retry, or open the details to diagnose the problem."
