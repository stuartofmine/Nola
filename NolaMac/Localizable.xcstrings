          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS 已阻止通知发送。请在系统设置中开启权限。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS 已阻止通知傳送。請在系統設定中開啟權限。"
          }
        }
      }
    },
    "mac.settings.notifications.permission_denied_feedback" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS hat den Mitteilungszugriff verweigert. Die Ereignisoptionen bleiben gesperrt, bis du die Berechtigung in den Systemeinstellungen aktivierst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS denied notification access. Event controls remain unavailable until permission is enabled in System Settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS denegó el acceso a las notificaciones. Los controles de eventos no estarán disponibles hasta que actives el permiso en Ajustes del Sistema."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS a refusé l’accès aux notifications. Les réglages d’événements restent indisponibles jusqu’à l’activation de l’autorisation dans Réglages Système."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS が通知へのアクセスを拒否しました。システム設定で権限を有効にするまでイベント設定は利用できません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS가 알림 접근을 거부했습니다. 시스템 설정에서 권한을 활성화할 때까지 이벤트 설정을 사용할 수 없습니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS запретила доступ к уведомлениям. Настройки событий недоступны, пока разрешение не будет включено в Системных настройках."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS 拒绝了通知权限。在系统设置中开启权限前，事件选项不可用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS 拒絕了通知權限。在系統設定中開啟權限前，事件選項無法使用。"
          }
        }
      }
    },
