            "value" : "Dies kann nicht rückgängig gemacht werden. Exportieren Sie zuerst eine Sicherung, wenn Sie die Daten später benötigen könnten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This cannot be undone. Export a backup first if you may need this data later."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta acción no se puede deshacer. Exporta antes una copia si puedes necesitar estos datos más adelante."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette action est irréversible. Exportez d’abord une sauvegarde si vous pourriez avoir besoin de ces données."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この操作は取り消せません。後で必要になる可能性がある場合は、先にバックアップを書き出してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 작업은 취소할 수 없습니다. 나중에 이 데이터가 필요할 경우 먼저 백업을 내보내십시오."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это действие нельзя отменить. Сначала экспортируйте копию, если данные могут понадобиться позже."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此操作无法撤销。如果以后可能需要这些数据，请先导出备份。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此操作無法撤銷。如果以後可能需要這些資料，請先導出備份。"
          }
        }
      }
    },
