    "A JSON backup includes conversations, activity, automations, notifications, web sources, prompt templates, model parameters, and non-credential preferences." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein JSON-Backup enthält Unterhaltungen, Aktivitäten, Automatisierungen, Mitteilungen, Webquellen, Prompt-Vorlagen, Modellparameter und Einstellungen ohne Zugangsdaten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A JSON backup includes conversations, activity, automations, notifications, web sources, prompt templates, model parameters, and non-credential preferences."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una copia JSON incluye conversaciones, actividad, automatizaciones, notificaciones, fuentes web, plantillas de instrucciones, parámetros del modelo y preferencias sin credenciales."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une sauvegarde JSON contient les conversations, l’activité, les automatisations, les notifications, les sources web, les modèles de prompts, les paramètres de modèle et les préférences sans identifiants."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "JSON バックアップには、会話、アクティビティ、自動化、通知、Web ソース、プロンプトテンプレート、モデル設定、認証情報を除く環境設定が含まれます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "JSON 백업에는 대화, 활동, 자동화, 알림, 웹 소스, 프롬프트 템플릿, 모델 매개변수 및 자격 증명을 제외한 환경설정이 포함됩니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Резервная копия JSON содержит беседы, действия, автоматизации, уведомления, веб-источники, шаблоны запросов, параметры модели и настройки без учётных данных."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "JSON 备份包含对话、活动、自动化、通知、网页来源、提示词模板、模型参数及不含凭据的偏好设置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "JSON 備份包含對話、活動、自動化、通知、網頁來源、提示詞範本、模型參數及不含憑證的偏好設定。"
          }
        }
      }
    },
