    "mac.data.restore.summary.format" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sicherung vom %@ · %lld Unterhaltungen · %lld Aktivitäten · %lld Automatisierungen · %lld Mitteilungen · %lld Webquellen. Die Wiederherstellung ersetzt diese lokalen Sammlungen und Einstellungen ohne Anmeldedaten; gespeicherte Anmeldedaten bleiben erhalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Backup from %@ · %lld conversations · %lld activities · %lld automations · %lld notifications · %lld web sources. Restoring replaces these local collections and non-credential preferences; existing saved credentials are kept."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copia del %@ · %lld conversaciones · %lld actividades · %lld automatizaciones · %lld notificaciones · %lld fuentes web. La restauración sustituye estas colecciones locales y preferencias sin credenciales; se conservan las credenciales guardadas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sauvegarde du %@ · %lld conversations · %lld activités · %lld automatisations · %lld notifications · %lld sources web. La restauration remplace ces collections locales et préférences sans identifiants ; les identifiants enregistrés sont conservés."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ のバックアップ · 会話 %lld 件 · アクティビティ %lld 件 · 自動化 %lld 件 · 通知 %lld 件 · Web 情報源 %lld 件。復元するとこれらのローカルデータと認証情報以外の設定が置き換わり、保存済みの認証情報は保持されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@의 백업 · %lld개의 대화 · %lld개의 활동 · %lld개의 자동화 · %lld개의 알림 · %lld개의 웹 소스. 복원 시 이 로컬 컬렉션과 자격 증명이 아닌 환경설정이 대체되며, 기존 저장된 자격 증명은 유지됩니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Копия от %@ · диалогов: %lld · действий: %lld · автоматизаций: %lld · уведомлений: %lld · веб-источников: %lld. Восстановление заменит эти локальные коллекции и настройки без учётных данных; сохранённые учётные данные останутся."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "备份时间 %@ · %lld 个对话 · %lld 条活动 · %lld 个自动化 · %lld 条通知 · %lld 个网页来源。恢复会替换这些本地集合和非凭证偏好；现有已保存凭证会保留。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "備份時間 %@ · %lld 個對話 · %lld 條活動 · %lld 個自動化 · %lld 條通知 · %lld 個網頁來源。恢復會替換這些本地集合和非憑證偏好；現有已保存憑證會保留。"
          }
        }
      }
    },
