    "mac.data.reset.description" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Löscht Unterhaltungen, Aktivitäten, Automatisierungen, Einstellungen, Verbindungsdaten und Anmeldedaten, das Arbeitsbereich-Lesezeichen sowie App-Protokolle von Nola für Mac. Eigenständige CLI-Konfigurationen und Sitzungen bleiben erhalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clears Nola for Mac conversations, activity, automations, preferences, connection settings and credentials, workspace bookmark, and app logs. Independent CLI configuration and sessions are preserved."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Borra conversaciones, actividad, automatizaciones, preferencias, configuración y credenciales de conexión, el marcador del espacio de trabajo y los registros de Nola para Mac. Se conservan la configuración y las sesiones independientes de CLI."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Efface les conversations, l’activité, les automatisations, les préférences, les réglages et identifiants de connexion, le signet d’espace de travail et les journaux de Nola pour Mac. La configuration et les sessions CLI indépendantes sont conservées."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nola Mac 版の会話、アクティビティ、自動化、環境設定、接続設定と認証情報、ワークスペースのブックマーク、アプリログを消去します。独立した CLI 設定とセッションは保持されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nola for Mac의 대화, 활동, 자동화, 환경설정, 연결 설정 및 자격 증명, 작업 공간 책갈피, 앱 로그를 지웁니다. 독립적인 CLI 구성 및 세션은 유지됩니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удаляет диалоги, активность, автоматизации, настройки, параметры подключения и учётные данные, закладку рабочей области и журналы Nola для Mac. Независимая конфигурация и сеансы CLI сохраняются."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "清除 Nola Mac 版的对话、活动、自动化、偏好设置、连接配置与凭证、工作区书签及应用日志。独立的 CLI 配置和会话会保留。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "清除 Nola Mac 版的對話、活動、自動化、偏好設定、連接配置與憑證、工作區書簽及App日誌。獨立的 CLI 配置和會話會保留。"
          }
        }
      }
    },
