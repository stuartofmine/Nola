    "Complete the request in your browser, then return here. Closing this sheet stops Nola’s pending flow, not access already granted at the source." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schließe die Autorisierung im Browser ab und kehre zurück. Das Schließen beendet Nolas offenen Vorgang, widerruft aber keine bereits erteilten Rechte."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Complete the request in your browser, then return here. Closing this sheet stops Nola’s pending flow, not access already granted at the source."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Completa la autorización en el navegador y vuelve. Cerrar esta hoja detiene el proceso pendiente de Nola, pero no revoca el acceso ya concedido."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terminez dans le navigateur puis revenez. Fermer cette fenêtre arrête le processus Nola en attente, sans révoquer l’accès déjà accordé."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ブラウザで完了してから戻ってください。この画面を閉じるとNolaの待機中の処理は停止しますが、既に付与されたアクセス権は取り消しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "브라우저에서 완료한 뒤 돌아오세요. 이 창을 닫으면 Nola의 대기 절차는 중지되지만 이미 부여된 접근 권한은 취소되지 않습니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Завершите авторизацию в браузере и вернитесь. Закрытие окна остановит ожидающий процесс Nola, но не отзовёт уже выданный доступ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请在浏览器完成授权后返回。关闭此窗口会停止 Nola 的待处理流程，但不会撤销来源已授予的访问权限。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請在瀏覽器完成授權後返回。關閉此視窗會停止 Nola 的待處理流程，但不會撤銷來源已授予的存取權限。"
          }
        }
      }
    },
