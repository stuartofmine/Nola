    "onboarding.core.local_note" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Kernerlebnis arbeitet zuerst lokal. Ein Host ergänzt Funktionen, ist aber nie erforderlich."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Works locally first. A host adds capabilities; it is never required for the core experience."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La experiencia principal funciona primero en local. Un host añade capacidades, pero nunca es obligatorio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’expérience de base fonctionne d’abord localement. Un hôte ajoute des capacités sans être requis."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "基本体験はローカル優先です。ホストは機能を追加しますが必須ではありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "먼저 로컬에서 작동합니다. 호스트는 기능을 추가하지만, 핵심 경험에는 필수가 아닙니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Основной опыт работает локально. Хост добавляет возможности, но не обязателен."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "核心体验优先在本地工作。宿主机只增加能力，从来不是必需条件。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "核心體驗優先在本地工作。宿主機只增加能力，從來不是必需條件。"
          }
        }
      }
    },
    "onboarding.core.loop_body" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nola verbindet ausgewählte Informationen, zeigt die Quellen jeder Antwort und behält nur dauerhafte Details."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nola connects the information you choose, shows what each answer used, and keeps only the durable details worth remembering."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nola conecta la información elegida, muestra las fuentes de cada respuesta y conserva solo detalles duraderos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nola relie les informations choisies, montre les sources utilisées et ne conserve que les détails durables."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選んだ情報をつなぎ、回答の根拠を示し、長く覚える価値のある内容だけを残します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nola는 사용자가 선택한 정보를 연결하고, 각 답변이 사용한 내용을 표시하며, 기억할 가치가 있는 지속적인 세부 사항만 유지합니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nola связывает выбранную информацию, показывает источники ответов и хранит только важные долговременные детали."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nola 连接你选择的信息，说明每次回答用了什么，只保留值得长期记住的内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nola 連接你選擇的資訊，說明每次回答用了什麼，只保留值得長期記住的內容。"
          }
        }
      }
    },
