      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在系统设置中检查 Nola 的访问权限，返回后会刷新状态。受限制的权限可能需要组织管理员调整。"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Review Nola’s access in System Settings, then return here to refresh its status. Restrictions may be managed by your organization."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nolas Zugriff in den Systemeinstellungen prüfen und zurückkehren. Einschränkungen werden möglicherweise von deiner Organisation verwaltet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Revisa el acceso de Nola en Ajustes del Sistema y vuelve para actualizar el estado. Tu organización puede gestionar las restricciones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vérifiez l’accès de Nola dans Réglages Système, puis revenez pour actualiser l’état. Les restrictions peuvent être gérées par votre organisation."
