    "Transform papers into editable, evidence-linked presentations with slide-level QA." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwandelt Fachartikel in bearbeitbare, evidenzverknüpfte Präsentationen mit Folienprüfung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transform papers into editable, evidence-linked presentations with slide-level QA."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Convierte artículos en presentaciones editables vinculadas a evidencias y verificadas por diapositiva."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transforme des articles en présentations modifiables liées aux preuves et vérifiées par diapositive."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "論文を根拠に紐づく編集可能なスライドへ変換し、各ページを検証します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "논문을 근거와 연결된 편집 가능한 발표 자료로 변환하고 슬라이드별로 검증합니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Преобразует статьи в редактируемые презентации с привязкой к доказательствам."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将论文转为可编辑、证据可追溯并经过逐页质检的演示文稿。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將論文轉為可編輯、證據可追溯並經過逐頁質檢的簡報。"
          }
        }
      }
    },
