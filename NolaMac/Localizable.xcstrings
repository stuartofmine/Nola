    "onboarding.guide.sources.body" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quellen erst bei Bedarf hinzufügen. Systemrechte und Chat-Zugriff sind getrennt; ohne Datenfreigabe bleibt der Chat nutzbar."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add sources when you use the related feature. System permission and conversation access are separate; declining data access still lets you chat."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade fuentes al usar la función. El permiso del sistema y el acceso del chat son independientes; puedes conversar aunque rechaces el acceso a datos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez des sources au moment de les utiliser. Autorisation système et accès de la conversation sont distincts ; le chat reste disponible sans accès aux données."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "必要な機能を使うときにソースを追加します。システム権限と会話へのアクセスは別設定です。データアクセスを拒否してもチャットできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "해당 기능을 사용할 때 소스를 추가하세요. 시스템 권한과 대화 접근은 별도 설정이며, 데이터 접근을 거부해도 채팅할 수 있습니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавляйте источники по мере использования. Системное разрешение и доступ чата настраиваются отдельно; отказ в доступе к данным не мешает чату."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用相关功能时再添加来源。系统授权与对话访问策略分别设置；拒绝数据权限后仍可使用聊天。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用相關功能時再加入來源。系統授權與對話存取原則分別設定；拒絕資料權限後仍可使用聊天。"
          }
        }
      }
    },
    "onboarding.guide.sources.permission_note" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Systemrechte erlauben Nola das Lesen. Ob Daten in den Modellkontext gelangen, bestimmen weiterhin Quellenrichtlinie und Chat-Auswahl."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "System permission lets Nola read data. Source access policy and conversation choices still control whether it enters model context."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El permiso del sistema permite leer datos. La política de la fuente y las opciones de la conversación deciden si entran en el contexto del modelo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’autorisation système permet la lecture. La politique de la source et les choix de la conversation déterminent l’ajout au contexte du modèle."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "システム権限はデータの読み取りを許可します。モデルのコンテキストに含めるかは、ソースのアクセスポリシーと会話の選択で決まります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시스템 권한은 Nola의 데이터 읽기를 허용합니다. 모델 컨텍스트 포함 여부는 소스 접근 정책과 대화 선택에 따라 결정됩니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Системное разрешение позволяет читать данные. Включение в контекст модели по-прежнему определяется политикой источника и выбором в чате."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "系统授权允许 Nola 读取资料。是否加入模型上下文，仍由来源访问策略和当前对话选择决定。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "系統授權允許 Nola 讀取資料。是否加入模型上下文，仍由來源存取原則和目前對話選擇決定。"
          }
        }
      }
    },
