    "Signing in does not run a model, discover models or enable a subscription route. Eligibility and available models are determined by the service." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Anmeldung startet oder ermittelt keine Modelle und aktiviert keine Abo-Inferenz. Berechtigung und Modelle bestimmt der Dienst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Signing in does not run a model, discover models or enable a subscription route. Eligibility and available models are determined by the service."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iniciar sesión no ejecuta ni descubre modelos ni activa inferencia por suscripción. El servicio determina el acceso y los modelos disponibles."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La connexion ne lance ni ne découvre de modèles et n’active pas l’inférence par abonnement. Le service détermine l’éligibilité et les modèles disponibles."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サインインではモデルの実行・取得やサブスクリプション推論の有効化は行いません。利用資格とモデルはサービスが決定します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "로그인만으로 모델 실행·검색이나 구독 추론이 활성화되지 않습니다. 이용 자격과 모델은 서비스가 결정합니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вход не запускает и не ищет модели и не включает генерацию по подписке. Доступ и модели определяет сервис."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "登录不会调用或发现模型，也不会启用订阅推理。使用资格和可用模型由服务决定。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "登入不會呼叫或探索模型，也不會啟用訂閱推論。使用資格和可用模型由服務決定。"
          }
        }
      }
    },
