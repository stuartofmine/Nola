          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS가 알림 전송을 차단하고 있습니다. 시스템 설정에서 권한을 활성화하세요."
          }
        },
        "ru" : {
          "stringUnit" : {
