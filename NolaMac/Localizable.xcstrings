    "Tests this endpoint with one configured model. A successful route test does not establish which reasoning efforts the model supports." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Testet diesen Endpunkt mit einem konfigurierten Modell. Ein erfolgreicher Verbindungstest sagt nicht aus, welche Reasoning-Aufwandsstufen das Modell unterstützt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tests this endpoint with one configured model. A successful route test does not establish which reasoning efforts the model supports."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prueba este endpoint con un modelo configurado. Una prueba de conexión correcta no determina qué niveles de razonamiento admite el modelo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teste ce point de terminaison avec un modèle configuré. Un test de connexion réussi ne détermine pas les niveaux d’effort de raisonnement pris en charge par le modèle."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "設定済みのモデル1つでこのエンドポイントをテストします。接続テストに成功しても、モデルが対応する思考強度は確認できません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "설정된 모델 하나로 이 엔드포인트를 테스트합니다. 연결 테스트가 성공해도 모델이 지원하는 사고 강도를 확인할 수는 없습니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Проверяет эту конечную точку с одной настроенной моделью. Успешное подключение не определяет, какие уровни рассуждений поддерживает модель."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用一个已配置的模型测试此端点。连接测试成功不代表已确认模型支持哪些思考强度。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用一個已設定的模型測試此端點。連線測試成功不代表已確認模型支援哪些思考強度。"
          }
        }
      }
    },
