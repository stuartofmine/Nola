    "mac.health.empty.detail" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffnen Sie nach Freigabe des Gesundheitszugriffs das Gesundheitsdashboard von Nola auf dem iPhone. Die nächste erfolgreiche Aktualisierung veröffentlicht eine aggregierte Übersicht über iCloud."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open Nola’s Health dashboard on iPhone after granting Health access. The next successful refresh publishes an aggregate snapshot through iCloud."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tras conceder acceso a Salud, abre el panel de Salud de Nola en el iPhone. La siguiente actualización correcta publicará un resumen agregado mediante iCloud."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Après avoir autorisé l’accès à Santé, ouvrez le tableau de bord Santé de Nola sur l’iPhone. La prochaine actualisation réussie publiera un résumé agrégé via iCloud."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ヘルスケアへのアクセスを許可した後、iPhone で Nola のヘルスケア画面を開いてください。次回の正常な更新で集約スナップショットが iCloud に公開されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone에서 건강 접근을 허용한 후 Nola 건강 대시보드를 여세요. 다음 새로고침 성공 시 iCloud로 요약이 공유됩니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "После предоставления доступа к данным Здоровья откройте панель Здоровья Nola на iPhone. Следующее успешное обновление опубликует агрегированную сводку через iCloud."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "授权健康数据后，在 iPhone 上打开 Nola 的健康面板。下次成功刷新会通过 iCloud 发布汇总快照。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "授權健康資料後，在 iPhone 上打開 Nola 的健康面板。下次成功重新整理會通過 iCloud 發佈匯總快照。"
          }
        }
      }
    },
