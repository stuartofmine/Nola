    "Nola can notify you when a long-running local or connected-host agent finishes while the app is in the background." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nola kann dich benachrichtigen, wenn ein länger laufender lokaler oder verbundener Agent im Hintergrund fertig wird."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nola can notify you when a long-running local or connected-host agent finishes while the app is in the background."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nola puede avisarte cuando un agente local o conectado de larga duración termina en segundo plano."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nola peut vous prévenir lorsqu’un agent local ou connecté de longue durée se termine en arrière-plan."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリがバックグラウンドの間に、長時間実行中のローカルまたは接続先エージェントが完了すると通知できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nola는 앱이 백그라운드에 있는 동안 장기 실행 중인 로컬 또는 연결된 호스트 에이전트가 완료되면 알릴 수 있습니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nola может уведомить о завершении длительной задачи локального или подключённого агента в фоне."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当应用位于后台时，本地或已连接宿主机上的长时间智能体任务完成后，Nola 可以通知你。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "當App位於後台時，本地或已連接宿主機上的長時間智慧代理任務完成後，Nola 可以通知你。"
          }
        }
      }
    },
