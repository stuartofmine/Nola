    "This Mac’s account changed. Check status before choosing another action; no changes were retried." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Konto dieses Macs wurde geändert. Prüfe den Status vor weiteren Aktionen; Änderungen wurden nicht wiederholt."
          }
        },
