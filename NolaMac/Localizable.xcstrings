          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diseña automatizaciones observables y conscientes de permisos con pruebas seguras y gestión de fallos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
