    "Design editable PowerPoint presentations with clear narrative, consistent layouts, and verified output." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gestaltet bearbeitbare PowerPoint-Präsentationen mit klarer Erzählung, konsistenten Layouts und geprüfter Ausgabe."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Design editable PowerPoint presentations with clear narrative, consistent layouts, and verified output."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diseña presentaciones de PowerPoint editables con narrativa clara, diseños coherentes y resultados verificados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conçoit des présentations PowerPoint modifiables avec un récit clair, des mises en page cohérentes et un résultat vérifié."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "明確なストーリー、一貫したレイアウト、検証済みの出力を備えた編集可能なPowerPointを作成します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "명확한 흐름과 일관된 레이아웃을 갖추고 결과가 검증된 편집 가능한 PowerPoint를 만듭니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Создаёт редактируемые презентации PowerPoint с ясным повествованием, едиными макетами и проверенным результатом."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "设计叙事清晰、版式一致且经过验证的可编辑 PowerPoint 演示文稿。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "設計敘事清晰、版式一致且經過驗證的可編輯 PowerPoint 簡報。"
          }
        }
      }
    },
    "Design observable, permission-aware automations with safe testing and failure handling." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beobachtbare, berechtigungsbewusste Automatisierungen mit sicheren Tests und Fehlerbehandlung entwerfen."
          }
