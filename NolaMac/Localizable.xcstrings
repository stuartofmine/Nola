    "Extract and verify structured text, tables, and fields from images and scans." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Strukturierten Text, Tabellen und Felder aus Bildern und Scans extrahieren und prüfen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Extract and verify structured text, tables, and fields from images and scans."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Extrae y verifica texto estructurado, tablas y campos de imágenes y escaneos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Extraire et vérifier le texte structuré, les tableaux et les champs des images et numérisations."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "画像やスキャンから構造化テキスト、表、項目を抽出して検証します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이미지와 스캔에서 구조화된 텍스트, 표 및 필드를 추출하고 검증합니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Извлечение и проверка структурированного текста, таблиц и полей из изображений и сканов."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从图片和扫描件中提取并验证结构化文本、表格与字段。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "從圖片和掃描件中擷取並驗證結構化文字、表格與欄位。"
          }
        }
      }
    },
