          "stringUnit" : {
            "state" : "translated",
            "value" : "This Mac’s account changed. Check status before choosing another action; no changes were retried."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La cuenta de este Mac cambió. Comprueba su estado antes de continuar; no se reintentaron cambios."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
