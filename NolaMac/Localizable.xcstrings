          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS is blocking delivery. Change the permission in System Settings to enable it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS está bloqueando la entrega. Cambia el permiso en Ajustes del Sistema para activarla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
