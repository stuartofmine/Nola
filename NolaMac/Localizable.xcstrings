      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Berechtigungen und Aktualität für Kontakte, Kalender, Erinnerungen, Mitteilungen und iPhone-Gesundheit prüfen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Review live authorization and freshness for contacts, calendars, reminders, notifications, and iPhone health sync."
