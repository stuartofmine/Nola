    "This account requires reauthorization. Use Reauthorize for this same account; Nola will not switch accounts automatically." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Konto muss erneut autorisiert werden. Nutze dafür dasselbe Konto; Nola wechselt Konten nicht automatisch."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This account requires reauthorization. Use Reauthorize for this same account; Nola will not switch accounts automatically."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta cuenta requiere nueva autorización. Usa Reautorizar para esta misma cuenta; Nola no cambia de cuenta automáticamente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce compte doit être réautorisé. Réautorisez ce même compte ; Nola ne change pas de compte automatiquement."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このアカウントの再認証が必要です。同じアカウントの再認証を選んでください。Nolaは自動でアカウントを切り替えません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 계정은 재인증이 필요합니다. 같은 계정에서 재인증을 선택하세요. Nola는 계정을 자동으로 전환하지 않습니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нужна повторная авторизация этого аккаунта. Выберите её для того же аккаунта; Nola не переключает аккаунты автоматически."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此账户需要重新授权。请对同一账户使用“重新授权”；Nola 不会自动切换账户。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此帳戶需要重新授權。請對同一帳戶使用「重新授權」；Nola 不會自動切換帳戶。"
          }
        }
      }
    },
