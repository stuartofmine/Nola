    "mac.settings.diagnostics.privacy" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warnungen und Fehler werden immer erfasst. Detaillierte Protokolle bleiben auf diesem Mac, rotieren automatisch und schließen Nachrichten, Zugangsdaten, vollständige URLs und Dateipfade aus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warnings and errors are always recorded. Detailed logs stay on this Mac, rotate automatically, and exclude message content, credentials, full URLs, and file paths."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las advertencias y errores siempre se registran. Los registros detallados permanecen en este Mac, rotan automáticamente y excluyen mensajes, credenciales, URL completas y rutas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les avertissements et erreurs sont toujours enregistrés. Les journaux détaillés restent sur ce Mac, tournent automatiquement et excluent messages, identifiants, URL complètes et chemins."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "警告とエラーは常に記録されます。詳細ログはこの Mac にのみ保存され、自動ローテーションされ、メッセージ、認証情報、完全な URL、ファイルパスを除外します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "경고와 오류는 항상 기록됩니다. 상세 로그는 이 Mac에만 저장되며 자동으로 순환되며, 메시지 콘텐츠, 자격 증명, 전체 URL 및 파일 경로는 제외됩니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Предупреждения и ошибки записываются всегда. Подробные журналы остаются на этом Mac, автоматически ротируются и не включают сообщения, данные доступа, полные URL и пути."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "警告和错误始终记录。详细日志仅保存在此 Mac，自动轮转，并排除消息内容、凭据、完整 URL 和文件路径。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "警告和錯誤始終記錄。詳細日誌僅保存在此 Mac，自動輪轉，並排除消息內容、憑據、完整 URL 和檔案路徑。"
          }
        }
      }
    },
