    "onboarding.guide.runtime.note" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Anleitung verbindet keine Dienste, lädt keine Modelle und erteilt keine Rechte. Chats verwenden deine tatsächliche Modell- und Host-Auswahl."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This guide does not connect services, download models or grant access. Conversations use the model and Host you actually select."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta guía no conecta servicios, descarga modelos ni concede permisos. La conversación usa el modelo y Host que selecciones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce guide ne connecte aucun service, ne télécharge aucun modèle et n’accorde aucun accès. Les conversations utilisent votre sélection réelle."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このガイドではサービスへの接続、モデルのダウンロード、権限付与は行いません。会話には実際に選んだモデルと Host を使います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 안내는 서비스 연결, 모델 다운로드 또는 권한 부여를 수행하지 않습니다. 대화는 실제로 선택한 모델과 Host를 사용합니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Руководство не подключает службы, не скачивает модели и не выдаёт разрешения. Чат использует фактически выбранные модель и Host."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
