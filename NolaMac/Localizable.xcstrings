    "mac.medication.disclaimer" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffentliche Kennzeichnungsinformationen dienen nur als Referenz und ersetzen keine ärztliche oder pharmazeutische Beratung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Public label information is for reference only and does not replace advice from a doctor or pharmacist."
