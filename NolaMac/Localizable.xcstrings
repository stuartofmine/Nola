        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nola no puede conectarse al servicio de la aplicación. Reinténtalo o abre los detalles para identificar el problema."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nola ne peut pas se connecter au service de l’application. Réessayez ou consultez les détails pour identifier le problème."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nola のアプリケーションサービスに接続できません。再試行するか、詳細を開いて問題を確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nola 애플리케이션 서비스에 연결할 수 없습니다. 다시 시도하거나 세부 정보를 열어 문제를 확인하세요."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nola не может подключиться к службе приложения. Повторите попытку или откройте сведения для диагностики проблемы."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nola 无法连接应用服务。请重试，或展开详情排查问题。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nola 無法連線至應用程式服務。請重試，或展開詳細資訊排查問題。"
