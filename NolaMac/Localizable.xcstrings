    "Read complete scientific papers with bilingual, figure-aware, source-grounded output." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liest vollständige Fachartikel zweisprachig, abbildungsbezogen und quellengebunden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Read complete scientific papers with bilingual, figure-aware, source-grounded output."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lee artículos científicos completos con salida bilingüe, sensible a figuras y basada en fuentes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lit des articles scientifiques complets avec un rendu bilingue, illustré et ancré dans les sources."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "科学論文全文を、図表と出典に対応した対訳形式で読み解きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "과학 논문 전체를 도표와 출처에 근거한 이중 언어 형식으로 읽습니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разбирает научные статьи целиком с двуязычным выводом, иллюстрациями и привязкой к источнику."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "完整精读科研论文，生成双语、图表感知且可追溯原文的结果。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "完整精讀科研論文，產生雙語、圖表感知且可追溯原文的結果。"
          }
        }
      }
    },
