    "Automation completion could not be committed. Check the execution status before retrying." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Abschlussstatus der Automatisierung konnte nicht gespeichert werden. Prüfe vor einem erneuten Versuch den Ausführungsstatus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automation completion could not be committed. Check the execution status before retrying."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo guardar el estado de finalización de la automatización. Comprueba el estado de ejecución antes de volver a intentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’état de fin de l’automatisation n’a pas pu être enregistré. Vérifiez l’état d’exécution avant de réessayer."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自動化の終了状態を保存できませんでした。再試行する前に実行状態を確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "자동화 종료 상태를 저장하지 못했습니다. 다시 시도하기 전에 실행 상태를 확인하세요."
