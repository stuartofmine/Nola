      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trage unten die Adresse und das beim Start angezeigte Zugriffstoken ein. Verwende ein vertrauenswürdiges privates Netzwerk oder HTTPS."
          }
        },
        "en" : {
