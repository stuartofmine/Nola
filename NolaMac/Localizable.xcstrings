    "Clears Nola for Mac conversations, activity, automations, preferences, workspace bookmark, and app logs. Independent CLI configuration and sessions are preserved." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Löscht Unterhaltungen, Aktivitäten, Automatisierungen, Einstellungen, das Arbeitsbereich-Lesezeichen und App-Protokolle von Nola für Mac. Eigenständige CLI-Konfigurationen und Sitzungen bleiben erhalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clears Nola for Mac conversations, activity, automations, preferences, workspace bookmark, and app logs. Independent CLI configuration and sessions are preserved."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Borra las conversaciones, actividad, automatizaciones, preferencias, el marcador del espacio de trabajo y los registros de Nola para Mac. Se conservan la configuración y las sesiones independientes de la CLI."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Efface les conversations, l’activité, les automatisations, les préférences, le signet d’espace de travail et les journaux de Nola pour Mac. La configuration et les sessions CLI indépendantes sont conservées."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nola for Mac の会話、アクティビティ、自動化、環境設定、ワークスペースのブックマーク、アプリログを消去します。独立した CLI の設定とセッションは保持されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac용 Nola의 대화, 활동, 자동화, 환경설정, 작업 공간 책갈피 및 앱 로그를 지웁니다. 독립 CLI 구성과 세션은 유지됩니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удаляет беседы, действия, автоматизации, настройки, закладку рабочей области и журналы Nola для Mac. Независимые конфигурация и сеансы CLI сохраняются."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "清除 Nola Mac 版的对话、活动、自动化、偏好设置、工作区书签和应用日志。独立的 CLI 配置与会话会保留。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "清除 Nola Mac 版的對話、活動、自動化、偏好設定、工作區書籤和 App 日誌。獨立的 CLI 設定與工作階段會保留。"
          }
        }
      }
    },
