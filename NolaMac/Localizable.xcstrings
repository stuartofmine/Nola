    "Unset selections inherit application defaults. Existing conversations keep their captured configuration." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unset selections inherit application defaults. Existing conversations keep their captured configuration."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未设置的选项继承应用默认值。已有会话保留其已冻结配置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未設定的選項會沿用應用程式預設值。現有對話會保留已記錄的設定。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未設定の選択はアプリの既定値を引き継ぎます。既存の会話は保存済みの設定を保持します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "미설정 선택은 앱 기본값을 따릅니다. 기존 대화는 저장된 설정을 유지합니다."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les choix non définis héritent des réglages de l’application. Les conversations existantes conservent leur configuration enregistrée."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nicht gesetzte Optionen übernehmen die App-Vorgaben. Bestehende Unterhaltungen behalten ihre erfasste Konfiguration."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las opciones sin definir heredan los valores de la aplicación. Las conversaciones existentes conservan su configuración guardada."
          }
        }
      }
    },
