    "This authorization does not grant plan usage. Reauthorize with the required consent before requesting models." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Autorisierung erlaubt keine Tarifnutzung. Autorisiere mit der nötigen Zustimmung erneut, bevor du Modelle anforderst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This authorization does not grant plan usage. Reauthorize with the required consent before requesting models."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta autorización no permite usar el plan. Vuelve a autorizar con el consentimiento requerido antes de solicitar modelos."
