        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nola peut vous prévenir lorsqu’une tâche longue locale ou distante se termine en arrière-plan."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ローカルまたは接続先ホストの長時間タスクがバックグラウンドで完了したときに通知できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nola는 앱이 백그라운드에 있을 때 장기 실행 로컬 또는 연결된 호스트 에이전트가 완료되면 알릴 수 있습니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nola может сообщать о завершении долгих локальных или удалённых задач в фоне."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本机或宿主机上的长任务在后台完成时，Nola 可以通知你。"
          }
        },
