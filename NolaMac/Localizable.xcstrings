    "onboarding.guide.ready.memory_note" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Langzeitwissen ist optional, sichtbar und bearbeitbar. Nola lernt mit dir, nicht an dir vorbei."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Long-term memory is optional, visible, and editable. Nola should learn with you, never around you."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La memoria a largo plazo es opcional, visible y editable. Nola aprende contigo, nunca a tus espaldas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La mémoire à long terme est facultative, visible et modifiable. Nola apprend avec vous, jamais sans vous."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "長期記憶は任意で、表示・編集できます。Nola はあなたと共に学び、勝手には学びません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "장기 메모리는 선택 사항이며, 확인 및 편집 가능합니다. Nola는 사용자와 함께 배워야 하며, 사용자를 몰래 배워서는 안 됩니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Долгая память необязательна, видима и редактируема. Nola учится вместе с вами, а не в обход вас."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "长期记忆始终可选、可见、可编辑。Nola 应该与你一起学习，而不是绕过你学习。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "長期記憶始終可選、可見、可編輯。Nola 應該與你一起學習，而不是繞過你學習。"
          }
        }
      }
    },
