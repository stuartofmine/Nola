    "Plan and draft evidence-bounded scientific manuscripts and submission materials." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plant und verfasst evidenzgebundene Manuskripte und Einreichungsunterlagen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plan and draft evidence-bounded scientific manuscripts and submission materials."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Planifica y redacta manuscritos y materiales de envío limitados por la evidencia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Planifie et rédige des manuscrits et dossiers de soumission bornés par les preuves."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "エビデンスの範囲を守って科学論文と投稿資料を構成・執筆します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "근거 범위를 지키며 과학 논문과 투고 자료를 기획하고 작성합니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Планирует и пишет рукописи и материалы для подачи в границах доказательств."
          }
        },
        "zh-Hans" : {
