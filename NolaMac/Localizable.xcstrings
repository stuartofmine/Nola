            "value" : "Mehrere autorisierte Profile entsprechen dem ursprünglichen Modell. Eine eindeutige Auswahl ist nicht nachweisbar."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "More than one authorized profile matches the original model. An exact choice cannot be proved."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varios perfiles autorizados coinciden con el modelo original. No se puede probar una elección única."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
