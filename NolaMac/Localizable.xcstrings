      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nola kann über abgeschlossene Langzeitaufgaben auf diesem Mac oder einem Host informieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nola can notify you when a long-running local or connected-host agent finishes while the app is in the background."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nola puede avisarte cuando termina una tarea larga local o del Host en segundo plano."
          }
