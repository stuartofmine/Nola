    "Changes apply only to this conversation and model. Unset values inherit model defaults." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "修改仅作用于当前会话和模型。未覆盖的参数沿用模型默认配置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "變更僅套用至此對話和模型。未設定的值會沿用模型預設值。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "変更はこの会話とモデルだけに適用されます。未設定の値はモデルの既定値を引き継ぎます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "변경은 이 대화와 모델에만 적용됩니다. 미설정 값은 모델 기본값을 따릅니다."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les modifications concernent uniquement cette conversation et ce modèle. Les valeurs non définies héritent des réglages du modèle."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Änderungen gelten nur für diese Unterhaltung und dieses Modell. Nicht gesetzte Werte übernehmen die Modellvorgaben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los cambios solo afectan a esta conversación y modelo. Los valores sin definir heredan los predeterminados del modelo."
          }
        }
      }
    },
