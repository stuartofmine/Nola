          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "提出問題、打開工作區或導入文檔。"
          }
        }
      }
    },
    "Ask before every operation outside the safe allowlist." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vor jedem Vorgang außerhalb der sicheren Liste nachfragen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ask before every operation outside the safe allowlist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preguntar antes de cada operación fuera de la lista segura."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demander avant chaque opération hors de la liste sûre."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "安全リスト外のすべての操作で確認します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "안전 허용 목록 외의 모든 작업 전에 묻습니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Спрашивать перед каждой операцией вне безопасного списка."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "安全白名单外的每个操作都询问。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "安全允許清單外的每個操作都詢問。"
          }
        }
      }
    },
    "Ask before private data access, memory, process execution, device control, and destructive operations. Existing scoped grants still apply." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vor privaten Daten, Erinnerungen, Prozessausführung, Gerätesteuerung und destruktiven Aktionen nachfragen. Bestehende begrenzte Freigaben gelten weiterhin."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ask before private data access, memory, process execution, device control, and destructive operations. Existing scoped grants still apply."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preguntar antes de acceder a datos privados, usar memoria, ejecutar procesos, controlar dispositivos o realizar acciones destructivas. Se mantienen los permisos de alcance específico."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demander avant l’accès aux données privées, la mémoire, l’exécution de processus, le contrôle des appareils et les actions destructrices. Les autorisations limitées existantes restent valables."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "個人データ、メモリ、プロセス実行、デバイス操作、破壊的な操作の前に確認します。既存の範囲限定の許可は引き続き有効です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "개인 데이터, 메모리, 프로세스 실행, 기기 제어 및 파괴적 작업 전에 확인합니다. 기존 범위별 권한은 유지됩니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запрашивать разрешение перед доступом к личным данным, использованием памяти, запуском процессов, управлением устройствами и разрушительными операциями. Ранее выданные разрешения в пределах их области действия сохраняются."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "访问私人数据、使用记忆、执行命令、控制设备及破坏性操作前询问。已授权的具体范围仍然有效。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "存取私人資料、使用記憶、執行命令、控制裝置及破壞性操作前詢問。已授權的具體範圍仍然有效。"
          }
        }
      }
    },
    "Ask only before destructive or irreversible operations." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
