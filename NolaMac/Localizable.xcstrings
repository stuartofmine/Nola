    "onboarding.guide.ready.body" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unter Einstellungen → Modelle eine Verbindung und ein Modell auswählen, dann die erste Nachricht senden. Für Quellen und Werkzeuge gelten ihre Zugriffsrichtlinien."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finish connecting and selecting a model in Settings → Models, then send your first message. Sources and tools follow their access policies."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conecta y selecciona un modelo en Ajustes → Modelos y envía tu primer mensaje. Las fuentes y herramientas siguen sus políticas de acceso."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connectez et sélectionnez un modèle dans Réglages → Modèles, puis envoyez votre premier message. Sources et outils suivent leurs politiques d’accès."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「設定 → モデル」で接続とモデルの選択を済ませ、最初のメッセージを送ります。ソースとツールは各アクセス方針に従います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "설정 → 모델에서 연결과 모델 선택을 마친 후 첫 메시지를 보내세요. 소스와 도구는 각 접근 정책을 따릅니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подключите и выберите модель в «Настройки → Модели», затем отправьте сообщение. Источники и инструменты используют свои политики доступа."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "先在“设置 → 模型”完成连接并选择模型，再发送第一条消息。来源与工具按各自的访问策略使用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "先在「設定 → 模型」完成連線並選擇模型，再傳送第一則訊息。來源與工具依各自的存取原則使用。"
          }
        }
      }
    },
