        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ultra es un modo multiagente de ChatGPT, no un nivel de razonamiento del modelo. Nola utiliza los niveles de razonamiento individuales disponibles para cada modelo."
