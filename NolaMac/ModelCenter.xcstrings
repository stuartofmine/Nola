    },
    "Ultra is a ChatGPT multi-agent mode, not a model reasoning effort. Nola uses the single-model reasoning levels available for each model." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ultra ist ein Multi-Agent-Modus von ChatGPT, keine Modell-Denkstufe. Nola verwendet die für das jeweilige Modell verfügbaren Einzelmodell-Denkstufen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
