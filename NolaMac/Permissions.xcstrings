    "Switching permissions…": {"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"正在切换权限…"}},"en":{"stringUnit":{"state":"translated","value":"Switching permissions…"}},"de":{"stringUnit":{"state":"translated","value":"Berechtigungen werden geändert…"}},"es":{"stringUnit":{"state":"translated","value":"Cambiando permisos…"}},"fr":{"stringUnit":{"state":"translated","value":"Modification des autorisations…"}},"ja":{"stringUnit":{"state":"translated","value":"権限を変更中…"}},"ru":{"stringUnit":{"state":"translated","value":"Изменение разрешений…"}}}},
