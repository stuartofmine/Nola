    "Saved; waiting for the running task": {"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"已保存，等待当前任务生效"}},"en":{"stringUnit":{"state":"translated","value":"Saved; waiting for the running task"}},"de":{"stringUnit":{"state":"translated","value":"Gespeichert; wartet auf laufende Aufgabe"}},"es":{"stringUnit":{"state":"translated","value":"Guardados; esperando la tarea actual"}},"fr":{"stringUnit":{"state":"translated","value":"Enregistrées ; en attente de la tâche"}},"ja":{"stringUnit":{"state":"translated","value":"保存済み・実行中のタスクの反映待ち"}},"ru":{"stringUnit":{"state":"translated","value":"Сохранено; ожидание текущей задачи"}}}},
    "Permissions active": {"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"当前任务已生效"}},"en":{"stringUnit":{"state":"translated","value":"Permissions active"}},"de":{"stringUnit":{"state":"translated","value":"Für laufende Aufgabe aktiv"}},"es":{"stringUnit":{"state":"translated","value":"Activos para la tarea actual"}},"fr":{"stringUnit":{"state":"translated","value":"Actives pour la tâche en cours"}},"ja":{"stringUnit":{"state":"translated","value":"実行中のタスクに適用済み"}},"ru":{"stringUnit":{"state":"translated","value":"Действует для текущей задачи"}}}},
    "Save not confirmed. Refresh and retry.": {"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"保存未确认，请刷新后重试。"}},"en":{"stringUnit":{"state":"translated","value":"Save not confirmed. Refresh and retry."}},"de":{"stringUnit":{"state":"translated","value":"Speichern nicht bestätigt. Aktualisieren und erneut versuchen."}},"es":{"stringUnit":{"state":"translated","value":"Guardado sin confirmar. Actualiza y reintenta."}},"fr":{"stringUnit":{"state":"translated","value":"Enregistrement non confirmé. Actualisez et réessayez."}},"ja":{"stringUnit":{"state":"translated","value":"保存を確認できません。更新して再試行してください。"}},"ru":{"stringUnit":{"state":"translated","value":"Сохранение не подтверждено. Обновите и повторите."}}}},
