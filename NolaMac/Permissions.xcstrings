    "Confirm deletion, overwrites, sensitive data access, outgoing content, and new connections. Ordinary reads and new files proceed.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirm deletion, overwrites, sensitive data access, outgoing content, and new connections. Ordinary reads and new files proceed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除、覆盖、敏感数据访问、外发内容和新连接先确认；普通读取与新建直接执行。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Löschen, Überschreiben, sensible Daten, ausgehende Inhalte und neue Verbindungen bestätigen. Normales Lesen und neue Dateien sind erlaubt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirma borrados, sobrescrituras, datos sensibles, envíos y conexiones nuevas. Las lecturas normales y los archivos nuevos continúan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirmer suppressions, écrasements, accès sensibles, envois et nouvelles connexions. Les lectures ordinaires et créations continuent."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "削除、上書き、機密データへのアクセス、外部送信、新規接続を確認します。通常の読み取りと新規作成は続行します。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подтверждать удаление, перезапись, доступ к конфиденциальным данным, отправку и новые подключения. Обычное чтение и создание файлов разрешены."
          }
        }
      }
    },
    "No Nola approval prompts in this conversation. System permissions still apply.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No Nola approval prompts in this conversation. System permissions still apply."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此会话内无需 Nola 确认，系统权限仍然生效。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Nola-Bestätigungen in diesem Gespräch. Systemberechtigungen gelten weiterhin."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin confirmaciones de Nola en esta conversación. Siguen vigentes los permisos del sistema."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune confirmation Nola dans cette conversation. Les autorisations système restent actives."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この会話では Nola の確認を省略します。システム権限は引き続き必要です。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Без подтверждений Nola в этой беседе. Системные разрешения остаются в силе."
          }
        }
      }
    }
  },
  "version": "1.0"
}
