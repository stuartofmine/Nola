{
  "schema_version": 1,
  "id": "conduct-deep-research",
  "delivery": "built-in",
  "category": {
    "id": "knowledge-research",
    "name": "Knowledge & Research",
    "name_zh": "知识与研究"
  },
  "source": {
    "project": "Nola",
    "license": "Apache-2.0"
  },
  "status": "stable",
  "platforms": [
    "macos",
    "cli-web"
  ],
  "required_tools": [
    "Skill",
    "web_search",
    "bash"
  ],
  "optional_tools": [
    "web_fetch",
    "read_file",
    "write_file",
    "append_file"
  ],
  "runtime_dependencies": [
    "python3 (standard library)"
  ],
  "permissions": [
    "network.required",
    "filesystem.read",
    "filesystem.write.confirm"
  ],
  "secrets": [],
  "validation": [
    "scripts/validate_research.py",
    "citation-to-source support audit",
    "source independence and freshness audit"
  ],
  "recommended_handoffs": [
    "nature-reader",
    "nature-ref-verifier",
    "word-document-authoring",
    "powerpoint-presentation-authoring"
  ],
  "execution_contract": {
    "schemaVersion": 1,
    "progressSteps": [
      {
        "id": "inspect",
        "title": "Inspect inputs and constraints",
        "required": true
      },
      {
        "id": "execute",
        "title": "Produce the requested outcome",
        "required": true
      },
      {
        "id": "verify",
        "title": "Verify the outcome with evidence",
        "required": true
      }
    ],
    "artifacts": [
      {
        "id": "research-report",
        "mediaType": "text/markdown",
        "required": false,
        "description": "Stable reference to the final requested outcome or its persisted receipt"
      }
    ],
    "verifiers": [
      {
        "id": "completion-audit",
        "method": "model_judgment",
        "description": "Record real evidence for the applicable completion checks: scripts/validate_research.py; citation-to-source support audit; source independence and freshness audit",
        "required": true
      }
    ],
    "resumePoints": [
      "after-inspect",
      "after-execute",
      "after-verify"
    ]
  }
}
