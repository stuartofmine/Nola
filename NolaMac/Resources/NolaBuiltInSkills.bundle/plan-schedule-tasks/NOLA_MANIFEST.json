{
  "schema_version": 1,
  "id": "plan-schedule-tasks",
  "delivery": "built-in",
  "category": {
    "id": "planning-automation",
    "name": "Planning & Automation",
    "name_zh": "计划与自动化"
  },
  "source": {
    "project": "Nola",
    "license": "Apache-2.0"
  },
  "status": "stable",
  "platforms": [
    "macos",
    "cli-web"
  ],
  "required_tools": [
    "Skill"
  ],
  "optional_tools": [
    "search_calendar_events",
    "search_reminders",
    "create_calendar_event",
    "create_reminder",
    "update_reminder",
    "read_file",
    "write_file",
    "bash"
  ],
  "runtime_dependencies": [
    "python3 (standard library)"
  ],
  "permissions": [
    "calendar.read",
    "reminders.read",
    "calendar.write.confirm",
    "reminders.write.confirm",
    "filesystem.write.confirm"
  ],
  "secrets": [],
  "validation": [
    "scripts/validate_schedule.py --validate-only --output <validation-receipt.json> --markdown-output <schedule.md>",
    "provider identifier and final conflict reconciliation"
  ],
  "recommended_handoffs": [
    "design-automations"
  ],
  "execution_contract": {
    "schemaVersion": 1,
    "progressSteps": [
      {
        "id": "inspect",
        "title": "Inspect inputs and constraints",
        "required": true
      },
      {
        "id": "execute",
        "title": "Produce the requested outcome",
        "required": true
      },
      {
        "id": "verify",
        "title": "Verify the outcome with evidence",
        "required": true
      }
    ],
    "artifacts": [
      {
        "id": "schedule-or-provider-receipt",
        "mediaType": "application/json",
        "required": false,
        "description": "Stable reference to the final requested outcome or its persisted receipt"
      }
    ],
    "verifiers": [
      {
        "id": "completion-audit",
        "method": "model_judgment",
        "description": "Record real evidence for the applicable completion checks: scripts/validate_schedule.py --validate-only --output <validation-receipt.json> --markdown-output <schedule.md>; provider identifier and final conflict reconciliation",
        "required": true
      }
    ],
    "resumePoints": [
      "after-inspect",
      "after-execute",
      "after-verify"
    ]
  }
}
