{
  "schema_version": 1,
  "id": "review-documents",
  "delivery": "built-in",
  "category": {
    "id": "documents",
    "name": "Documents",
    "name_zh": "文档处理"
  },
  "source": {
    "project": "Nola",
    "license": "Apache-2.0"
  },
  "status": "stable",
  "platforms": [
    "macos",
    "cli-web"
  ],
  "required_tools": [
    "Skill",
    "read_file"
  ],
  "optional_tools": [
    "write_file",
    "web_search"
  ],
  "runtime_dependencies": [],
  "permissions": [
    "filesystem.read",
    "filesystem.write.confirm",
    "network.optional"
  ],
  "secrets": [],
  "validation": [
    "finding-to-anchor audit",
    "edited-output preservation comparison",
    "tool:read_file reopen the final anchored review after all edits"
  ],
  "recommended_handoffs": [
    "word-document-authoring",
    "work-with-pdf"
  ],
  "execution_contract": {
    "schemaVersion": 1,
    "progressSteps": [
      {
        "id": "inspect",
        "title": "Inspect inputs and constraints",
        "required": true
      },
      {
        "id": "execute",
        "title": "Produce the requested outcome",
        "required": true
      },
      {
        "id": "verify",
        "title": "Verify the outcome with evidence",
        "required": true
      }
    ],
    "artifacts": [
      {
        "id": "review-report",
        "mediaType": "text/markdown",
        "required": false,
        "description": "Stable reference to the final requested outcome or its persisted receipt"
      }
    ],
    "verifiers": [
      {
        "id": "completion-audit",
        "method": "model_judgment",
        "description": "Record real evidence for the applicable completion checks: finding-to-anchor audit; edited-output preservation comparison; tool:read_file reopen the final anchored review after all edits",
        "required": true
      }
    ],
    "resumePoints": [
      "after-inspect",
      "after-execute",
      "after-verify"
    ]
  }
}
