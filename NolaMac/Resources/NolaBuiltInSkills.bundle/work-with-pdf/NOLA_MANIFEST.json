{
  "schema_version": 1,
  "id": "work-with-pdf",
  "delivery": "built-in",
  "category": {
    "id": "documents",
    "name": "Documents",
    "name_zh": "文档处理"
  },
  "source": {
    "project": "Nola",
    "license": "Apache-2.0"
  },
  "status": "stable",
  "platforms": [
    "macos",
    "cli-web"
  ],
  "required_tools": [
    "Skill",
    "read_file",
    "write_file",
    "bash"
  ],
  "optional_tools": [],
  "runtime_dependencies": [
    "swift",
    "macOS AppKit/CoreText/PDFKit frameworks"
  ],
  "permissions": [
    "filesystem.read",
    "filesystem.write.confirm",
    "pdf.irreversible.confirm"
  ],
  "secrets": [],
  "validation": [
    "scripts/create_pdf_report.swift --validate-only",
    "changed-page render audit"
  ],
  "recommended_handoffs": [
    "review-documents",
    "extract-image-text"
  ],
  "execution_contract": {
    "schemaVersion": 1,
    "progressSteps": [
      {
        "id": "inspect",
        "title": "Inspect inputs and constraints",
        "required": true
      },
      {
        "id": "execute",
        "title": "Produce the requested outcome",
        "required": true
      },
      {
        "id": "verify",
        "title": "Verify the outcome with evidence",
        "required": true
      }
    ],
    "artifacts": [
      {
        "id": "pdf-document",
        "mediaType": "application/pdf",
        "required": true,
        "description": "Stable reference to the final requested outcome or its persisted receipt"
      }
    ],
    "verifiers": [
      {
        "id": "completion-audit",
        "method": "model_judgment",
        "description": "Record real evidence for the applicable completion checks: scripts/create_pdf_report.swift --validate-only; changed-page render audit",
        "required": true
      }
    ],
    "resumePoints": [
      "after-inspect",
      "after-execute",
      "after-verify"
    ]
  }
}
