    "mac.settings.server.detail" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Andere Nola-Clients können die für diesen Nola Server konfigurierten Modelle, Werkzeuge, Skills, MCP-Server und Datenquellen verwenden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Other Nola clients can use the models, tools, Skills, MCP servers, and data sources configured for this Nola Server."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otros clientes Nola pueden usar los modelos, herramientas, Skills, servidores MCP y fuentes de datos configurados para este Nola Server."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les autres clients Nola peuvent utiliser les modèles, outils, Skills, serveurs MCP et sources de données configurés pour ce Nola Server."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ほかの Nola クライアントから、この Nola Server に設定されたモデル、ツール、Skill、MCP サーバー、データソースを利用できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다른 Nola 클라이언트가 이 Nola Server에 구성된 모델, 도구, Skill, MCP 서버 및 데이터 소스를 사용할 수 있습니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Другие клиенты Nola смогут использовать модели, инструменты, Skills, MCP-серверы и источники данных, настроенные для этого Nola Server."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "其他 Nola 客户端可以使用为此 Nola 服务器配置的模型、工具、技能、MCP 服务器和数据源。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "其他 Nola 用戶端可以使用為此 Nola 伺服器設定的模型、工具、技能、MCP 伺服器和資料來源。"
          }
        }
      }
    },
