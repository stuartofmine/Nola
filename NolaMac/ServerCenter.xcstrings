    "mac.settings.server.security" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur in einem vertrauenswürdigen privaten Netzwerk oder hinter HTTPS verwenden. Zugriffstoken geheim halten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use only on a trusted private network or behind HTTPS. Keep the access token private."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Úsalo solo en una red privada de confianza o detrás de HTTPS. Mantén privado el token."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez uniquement un réseau privé fiable ou HTTPS. Gardez le jeton confidentiel."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "信頼できるプライベートネットワークまたは HTTPS でのみ使用し、トークンを秘密にしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "신뢰할 수 있는 사설 네트워크 또는 HTTPS에서만 사용하고 토큰을 비공개로 유지하세요."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Используйте только в доверенной частной сети или через HTTPS. Храните токен в секрете."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅在可信私有网络或 HTTPS 后使用，并妥善保管访问令牌。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "僅在可信任的私人網路或 HTTPS 後使用，並妥善保管存取權杖。"
          }
        }
      }
    },
