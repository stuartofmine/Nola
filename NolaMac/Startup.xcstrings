        "ja" : { "stringUnit" : { "state" : "translated", "value" : "旧データを保存して起動" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "이전 데이터 보관 후 시작" } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Сохранить старые данные и запустить" } },
