{
  "llm": {
    "connections": [
      {
        "id": "primary",
        "name": "Primary service",
        "endpoint": "https://primary.example/v1",
        "protocol": "chat_completions",
        "api_key_env": "NOLA_PRIMARY_API_KEY",
        "models": [
          { "id": "fast-model", "name": "Fast", "context_window": 128000 },
          { "id": "reasoning-model", "name": "Reasoning", "context_window": 200000 }
        ]
      },
      {
        "id": "secondary",
        "name": "Secondary service",
        "endpoint": "https://secondary.example/v1",
        "protocol": "responses",
        "api_key_env": "NOLA_SECONDARY_API_KEY",
        "models": [{ "id": "model-name", "name": "Secondary model" }]
      }
    ],
    "default_model": { "connection": "primary", "model": "fast-model" }
  },
  "network_policy": "allow"
}
