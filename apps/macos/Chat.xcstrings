    "A browser connection is not an authorization. Managed browser and Chrome access are checked separately when used." : {
      "extractionState" : "stale",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "连接状态不代表授权。托管浏览器与 Chrome 会在使用时分别检查访问权限。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "連線狀態不代表授權。受管理瀏覽器與 Chrome 會在使用時分別檢查存取權限。"
          }
        }
      }
    },
    "A recovery decision is awaiting its receipt. Only that original decision can be recovered." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
