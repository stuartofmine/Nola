    "Close this task as blocked without retrying. External execution may still be running; this does not undo or confirm the operation." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Aufgabe ohne Wiederholung als blockiert schließen. Die externe Ausführung kann weiterlaufen; der Vorgang wird weder rückgängig gemacht noch bestätigt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Close this task as blocked without retrying. External execution may still be running; this does not undo or confirm the operation."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cerrar esta tarea como bloqueada sin reintentar. La ejecución externa puede continuar; esto no deshace ni confirma la operación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clôturer cette tâche comme bloquée sans réessayer. L’exécution externe peut continuer ; cela n’annule ni ne confirme l’opération."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "再試行せず、タスクをブロック状態で終了します。外部での実行は継続している可能性があり、操作の取り消しや結果の確認を意味しません。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Закрыть задачу как заблокированную без повтора. Внешнее выполнение может продолжаться; это не отменяет и не подтверждает операцию."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不重试，将任务按受阻状态关闭。外部执行可能仍在继续；这不会撤销或确认该操作。"
          }
        }
      }
