    "Remembering this approval applies only to the requested operation and resource in this conversation, not every command or file." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die gespeicherte Genehmigung gilt in diesem Gespräch nur für den angefragten Vorgang und die Ressource, nicht für alle Befehle oder Dateien."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta autorización se recuerda solo para la operación y el recurso solicitados en esta conversación, no para todos los comandos o archivos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette autorisation mémorisée ne concerne que l’opération et la ressource demandées dans cette conversation, pas toutes les commandes ni tous les fichiers."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "記憶した許可は、この会話で要求された操作とリソースにのみ適用されます。すべてのコマンドやファイルを許可するものではありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기억된 승인은 이 대화에서 요청한 작업과 리소스에만 적용되며 모든 명령이나 파일에 적용되지는 않습니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сохранённое разрешение действует только для запрошенной операции и ресурса в этом разговоре, а не для всех команд и файлов."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "记住授权仅适用于本会话中此次申请的操作和资源，并非允许所有命令或文件。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "記住授權僅適用於本對話中此次申請的操作和資源，並非允許所有命令或檔案。"
          }
        }
      }
    },
