    "Connection interrupted. Resume the existing remote run without sending a new message." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connection interrupted. Resume the existing remote run without sending a new message."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "连接已中断。恢复原远端运行，不发送新消息。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "連線已中斷。恢復原遠端執行，不傳送新訊息。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbindung unterbrochen. Setze den bestehenden Remote-Lauf fort, ohne eine neue Nachricht zu senden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se interrumpió la conexión. Reanuda la ejecución remota existente sin enviar un mensaje nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connexion interrompue. Reprenez l’exécution distante existante sans envoyer de nouveau message."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "接続が中断されました。新しいメッセージを送信せず、既存のリモート実行を再開してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "연결이 끊겼습니다. 새 메시지를 보내지 않고 기존 원격 실행을 재개합니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Соединение прервано. Возобновите существующий удалённый запуск, не отправляя новое сообщение."
          }
        }
      }
    },
