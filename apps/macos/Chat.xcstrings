    "Another conversation is still active. You can edit this draft and send it when that conversation finishes or is resolved." : {
      "extractionState" : "stale",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "另一个会话尚未结束。你可以继续编辑草稿，待该会话完成或处理完待确认状态后再发送。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "另一個對話尚未結束。你可以繼續編輯草稿，待該對話完成或處理完待確認狀態後再傳送。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine andere Unterhaltung ist noch aktiv. Du kannst diesen Entwurf bearbeiten und senden, sobald die andere Unterhaltung beendet oder geklärt ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
