    "Cancellation delivery finished. The original Run has not yet confirmed its final state." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cancellation delivery finished. The original Run has not yet confirmed its final state."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "取消投递已结束，原任务的最终状态尚未确认。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "取消投遞已結束，原任務的最終狀態尚未確認。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Übermittlung der Abbruchanforderung ist abgeschlossen. Der ursprüngliche Run hat seinen endgültigen Status noch nicht bestätigt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La entrega de la cancelación ha finalizado. La ejecución original aún no ha confirmado su estado final."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La transmission de l’annulation est terminée. Le Run d’origine n’a pas encore confirmé son état final."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キャンセル要求の送信が完了しました。元の Run の最終状態はまだ確認されていません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "취소 요청 전달이 완료되었습니다. 원래 실행의 최종 상태는 아직 확인되지 않았습니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Доставка запроса на отмену завершена. Исходный Run ещё не подтвердил своё окончательное состояние."
          }
        }
      }
    },
    "Cancellation keeps existing results and does not rerun commands." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "取消会保留已有结果，不会重新执行命令。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "取消會保留已有結果，不會重新執行命令。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beim Abbrechen bleiben vorhandene Ergebnisse erhalten; Befehle werden nicht erneut ausgeführt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La cancelación conserva los resultados existentes y no vuelve a ejecutar los comandos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’annulation conserve les résultats existants et ne relance pas les commandes."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キャンセルしても既存の結果は保持され、コマンドは再実行されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "취소해도 기존 결과는 유지되며 명령을 다시 실행하지 않습니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отмена сохраняет имеющиеся результаты и не запускает команды повторно."
          }
        }
      }
    },
