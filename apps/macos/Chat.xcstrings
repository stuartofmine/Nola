    "execution.scope.host" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Werkzeuge und Dateien gehören zum ausgewählten Host; eine Verbindung erteilt keine lokalen Berechtigungen."
          }
