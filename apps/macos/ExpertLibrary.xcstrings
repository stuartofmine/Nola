    "This disables the expert for future conversations. Existing conversations keep their saved history." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "停用后，新会话将无法使用此专家。已有会话保留历史记录。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Experte wird für künftige Unterhaltungen deaktiviert. Bestehende Verläufe bleiben erhalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se desactivará el experto para futuras conversaciones. Se conservarán los historiales existentes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’expert sera désactivé pour les futures conversations. Les historiques existants seront conservés."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今後の会話ではこのエキスパートが無効になります。既存の会話履歴は保持されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앞으로의 대화에서 이 전문가를 사용할 수 없습니다. 기존 대화 기록은 유지됩니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эксперт будет отключён для будущих бесед. История существующих бесед сохранится."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "停用後，新會話將無法使用此專家。已有會話保留歷史記錄。"
          }
        }
      }
    }
