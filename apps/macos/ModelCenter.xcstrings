    "Test stopped. A request already sent may still be charged; its result may be unknown." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Test gestoppt. Eine bereits gesendete Anfrage kann dennoch Kosten verursachen; ihr Ergebnis ist möglicherweise unbekannt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prueba detenida. Una solicitud ya enviada aún puede generar cargos y su resultado podría ser desconocido."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
