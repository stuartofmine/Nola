          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les fonctionnalités non cochées sont explicitement indiquées comme non prises en charge. Les utilisations autorisées n’activent pas les outils."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
