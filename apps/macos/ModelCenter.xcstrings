    "Select a source file, preview its connections, then confirm. Imported API keys stay in this Mac’s Keychain. Source files are never changed." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle eine Quelldatei aus, prüfe die Verbindungsvorschau und bestätige den Import. Importierte API-Schlüssel bleiben im Schlüsselbund dieses Macs. Quelldateien werden nie geändert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
