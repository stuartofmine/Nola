          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Непомеченные возможности явно не поддерживаются. Разрешённые варианты использования не включают инструменты."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
