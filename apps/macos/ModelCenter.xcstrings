    "The local runtime owns this authorization. Discover and enable models explicitly; signing in does not itself verify inference." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Autorisierung gehört der lokalen Laufzeit. Ermittle und aktiviere Modelle ausdrücklich; die Anmeldung bestätigt keine Inferenz."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La autorización pertenece al entorno local. Descubre y habilita modelos explícitamente; iniciar sesión no verifica la inferencia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’autorisation appartient à l’environnement local. Découvrez et activez les modèles explicitement ; la connexion ne valide pas l’inférence."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この認証はローカルランタイムが所有します。モデルは明示的に取得・有効化してください。サインインだけでは推論を検証できません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 인증은 로컬 런타임이 소유합니다. 모델을 명시적으로 검색하고 활성화하세요. 로그인 자체로 추론이 검증되지는 않습니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Авторизация принадлежит локальной среде. Явно найдите и включите модели; сам вход не подтверждает работу генерации."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此授权由本机运行时持有。请明确发现并启用模型；登录本身不代表推理已验证。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此授權由本機執行環境持有。請明確探索並啟用模型；登入本身不代表推論已驗證。"
          }
        }
      }
    },
    "The model credential could not be read or saved securely. The model settings were not changed." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Anmeldedaten des Modells konnten nicht sicher gelesen oder gespeichert werden. Die Modelleinstellungen wurden nicht geändert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudieron leer ni guardar las credenciales del modelo de forma segura. No se modificó la configuración del modelo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les identifiants du modèle n’ont pas pu être lus ou enregistrés de manière sécurisée. Les réglages du modèle n’ont pas été modifiés."
