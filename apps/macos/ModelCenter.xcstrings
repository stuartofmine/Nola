    "This sends one short text request and may incur provider charges. It does not test tools, images, or reasoning capabilities." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dabei wird eine kurze Textanfrage gesendet, für die Gebühren des Anbieters anfallen können. Werkzeuge, Bilder und Schlussfolgerungsfähigkeiten werden nicht getestet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto envía una solicitud breve de texto y puede generar cargos del proveedor. No prueba herramientas, imágenes ni capacidades de razonamiento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela envoie une courte requête textuelle et peut entraîner des frais du fournisseur. Les outils, les images et les capacités de raisonnement ne sont pas testés."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "短いテキストリクエストを1回送信します。プロバイダーの料金が発生する場合があります。ツール、画像、推論機能はテストしません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "짧은 텍스트 요청을 한 번 보내며 서비스 제공업체 요금이 발생할 수 있습니다. 도구, 이미지 또는 추론 기능은 테스트하지 않습니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Будет отправлен один короткий текстовый запрос; провайдер может взимать плату. Проверка не охватывает инструменты, изображения и рассуждение."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将发送一次简短文本请求，可能产生服务商费用。此测试不验证工具、图像或思考能力。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將發送一次簡短文本請求，可能產生服務商費用。此測試不驗證工具、圖像或思考能力。"
          }
        }
      }
    },
