      }
    },
    "This clears only this Nola account’s private credentials and requests remote revocation. It does not sign out Codex or another Host. Remote revocation may need confirmation in ChatGPT settings." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Löscht nur die privaten Daten dieses Nola-Kontos und fordert einen entfernten Widerruf an. Codex und andere Hosts bleiben angemeldet. Prüfe den Widerruf ggf. in ChatGPT."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo borra las credenciales privadas de esta cuenta Nola y solicita la revocación remota. No cierra Codex ni otros Hosts. Puede requerir confirmación en los ajustes de ChatGPT."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
