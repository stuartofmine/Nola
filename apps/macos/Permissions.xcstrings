    "Auto-allow workspace file edits. Confirm shell commands, outside-workspace writes, outgoing content, and new connections." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dateibearbeitungen im Arbeitsbereich automatisch zulassen. Shell-Befehle, Schreibvorgänge außerhalb, ausgehende Inhalte und neue Verbindungen bestätigen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auto-allow workspace file edits. Confirm shell commands, outside-workspace writes, outgoing content, and new connections."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite automáticamente ediciones en el espacio de trabajo. Confirma comandos de shell, escrituras externas, envíos y conexiones nuevas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autoriser automatiquement les modifications dans l’espace de travail. Confirmer les commandes shell, écritures externes, envois et nouvelles connexions."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ワークスペース内のファイル編集を自動許可します。シェルコマンド、ワークスペース外への書き込み、外部送信、新規接続は確認します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "작업 공간 내 파일 편집은 자동 허용합니다. 셸 명령, 작업 공간 외부 쓰기, 외부 전송 및 새 연결은 확인 후 진행합니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Автоматически разрешать правки файлов в рабочей области. Подтверждать команды оболочки, запись вне рабочей области, отправку и новые подключения."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "工作区内文件编辑自动放行；Shell 命令、工作区外写入、外发内容和新连接仍需确认。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "工作區內檔案編輯自動放行；Shell 指令、工作區外寫入、外發內容和新連接仍需確認。"
          }
        }
      }
    },
