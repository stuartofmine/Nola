    "Auto-allow workspace file edits. Confirm shell commands, outside-workspace writes, outgoing content, and new connections.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Auto-allow workspace file edits. Confirm shell commands, outside-workspace writes, outgoing content, and new connections."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "工作区内文件编辑自动放行；Shell 命令、工作区外写入、外发内容和新连接仍需确认。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "工作區內檔案編輯自動放行；Shell 指令、工作區外寫入、外發內容和新連接仍需確認。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
