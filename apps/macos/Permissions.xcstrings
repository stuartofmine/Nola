        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохранение не подтверждено. Обновите и повторите."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "保存未確認，請刷新後重試。"
          }
