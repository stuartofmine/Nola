    "Save not confirmed. Refresh and retry.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存未确认，请刷新后重试。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save not confirmed. Refresh and retry."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speichern nicht bestätigt. Aktualisieren und erneut versuchen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guardado sin confirmar. Actualiza y reintenta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrement non confirmé. Actualisez et réessayez."
          }
