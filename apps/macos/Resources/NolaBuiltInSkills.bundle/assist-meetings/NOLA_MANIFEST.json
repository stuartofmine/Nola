{
  "schema_version": 1,
  "id": "assist-meetings",
  "delivery": "built-in",
  "category": {
    "id": "communication",
    "name": "Communication",
    "name_zh": "沟通协作"
  },
  "source": {
    "project": "Nola",
    "license": "Apache-2.0"
  },
  "status": "stable",
  "platforms": [
    "macos",
    "cli-web"
  ],
  "required_tools": [
    "Skill"
  ],
  "optional_tools": [
    "read_file",
    "create_calendar_event",
    "create_reminder",
    "memory_save"
  ],
  "runtime_dependencies": [],
  "permissions": [
    "filesystem.read",
    "calendar.write.confirm",
    "reminders.write.confirm",
    "email.send.confirm",
    "memory.sensitive.confirm"
  ],
  "secrets": [],
  "validation": [
    "decision and action source-anchor audit",
    "external write receipt reconciliation",
    "tool:read_file reopen the final meeting output after all edits"
  ],
  "recommended_handoffs": [
    "plan-schedule-tasks",
    "assist-email",
    "curate-knowledge-memory"
  ],
  "execution_contract": {
    "schemaVersion": 1,
    "progressSteps": [
      {
        "id": "inspect",
        "title": "Inspect inputs and constraints",
        "required": true
      },
      {
        "id": "execute",
        "title": "Produce the requested outcome",
        "required": true
      },
      {
        "id": "verify",
        "title": "Verify the outcome with evidence",
        "required": true
      }
    ],
    "artifacts": [
      {
        "id": "meeting-record",
        "mediaType": "text/markdown",
        "required": false,
        "description": "Stable reference to the final requested outcome or its persisted receipt"
      }
    ],
    "verifiers": [
      {
        "id": "completion-audit",
        "method": "model_judgment",
        "description": "Record real evidence for the applicable completion checks: decision and action source-anchor audit; external write receipt reconciliation; tool:read_file reopen the final meeting output after all edits",
        "required": true
      }
    ],
    "resumePoints": [
      "after-inspect",
      "after-execute",
      "after-verify"
    ]
  }
}
