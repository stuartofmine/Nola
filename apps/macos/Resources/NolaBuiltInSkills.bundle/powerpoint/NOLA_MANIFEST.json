{
  "schema_version": 1,
  "id": "powerpoint-presentation-authoring",
  "delivery": "built-in",
  "category": {
    "id": "design-presentations",
    "name": "Design & Presentations",
    "name_zh": "设计与演示"
  },
  "source": {
    "project": "Nola",
    "license": "Apache-2.0"
  },
  "status": "stable",
  "platforms": [
    "macos",
    "cli-web"
  ],
  "required_tools": [
    "Skill",
    "read_file",
    "write_file",
    "bash"
  ],
  "optional_tools": [],
  "runtime_dependencies": [
    "python3 (standard library)"
  ],
  "permissions": [
    "filesystem.read",
    "filesystem.write.confirm"
  ],
  "secrets": [],
  "validation": [
    "scripts/create_presentation.py --validate-only"
  ],
  "recommended_handoffs": [
    "nature-paper2ppt",
    "analyze-data"
  ],
  "execution_contract": {
    "schemaVersion": 1,
    "progressSteps": [
      {
        "id": "inspect",
        "title": "Inspect inputs and constraints",
        "required": true
      },
      {
        "id": "execute",
        "title": "Produce the requested outcome",
        "required": true
      },
      {
        "id": "verify",
        "title": "Verify the outcome with evidence",
        "required": true
      }
    ],
    "artifacts": [
      {
        "id": "presentation",
        "mediaType": "application/vnd.openxmlformats-officedocument.presentationml.presentation",
        "required": true,
        "description": "Stable reference to the final requested outcome or its persisted receipt"
      }
    ],
    "verifiers": [
      {
        "id": "completion-audit",
        "method": "model_judgment",
        "description": "Record real evidence for the applicable completion checks: scripts/create_presentation.py --validate-only",
        "required": true
      }
    ],
    "resumePoints": [
      "after-inspect",
      "after-execute",
      "after-verify"
    ]
  }
}
