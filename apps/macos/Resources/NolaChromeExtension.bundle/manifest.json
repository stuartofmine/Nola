{
  "manifest_version": 3,
  "name": "Nola for Mac",
  "description": "Connects Chrome to Nola for Mac through Chrome Native Messaging.",
  "version": "0.2.0",
  "key": "",
  "action": {
    "default_title": "Connect Nola",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "activeTab",
    "debugger",
    "nativeMessaging",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ]
}
