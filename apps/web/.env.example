# Rust CLI Web backend
NOLA_WEB_HOST=127.0.0.1
NOLA_WEB_PORT=5001
NOLA_WEB_ROOT=../web

# CLI LLM defaults used by `cargo run -- web` and agent requests.
NOLA_ENDPOINT=
NOLA_API_KEY=
NOLA_MODEL=

# Optional local state path. Defaults to ~/.nola/cli/web/state.json.
NOLA_CLI_WEB_STATE=

# Native host bridge tokens are still used by installed Python native host
# scripts. The Rust CLI Web backend accepts local native host requests.
NOLA_NATIVE_BROWSER_TOKEN=
NOLA_NATIVE_APP_TOKEN=
