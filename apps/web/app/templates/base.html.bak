<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <meta name="format-detection" content="telephone=no">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="default">
    <meta name="apple-mobile-web-app-title" content="Nola">
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)">
    <meta name="theme-color" content="#141414" media="(prefers-color-scheme: dark)">
    <title>{% block title %}Nola - 智能任务管理{% endblock %}</title>
    <script>
    // Apply theme BEFORE CSS loads to avoid flash of wrong theme
    (function() {
        try {
            var t = localStorage.getItem('nola_theme');
            if (t === 'dark') document.documentElement.setAttribute('data-theme', 'dark');
        } catch (e) {}
    })();
    </script>
    <link rel="stylesheet" href="{{ url_for('static', filename='css/style.css') }}">
    {% block extra_css %}{% endblock %}
</head>
<body>
    <nav class="navbar">
        <div class="container">
            <div class="navbar-brand">
                <a href="/"><span>N</span>ola</a>
            </div>
            <!-- Dark mode toggle for mobile (top-right) -->
            <button type="button" id="darkModeToggleMobile" class="btn btn-nav dark-mode-toggle-mobile" title="切换暗黑模式" aria-label="切换暗黑模式">🌙</button>
            <button type="button" id="navToggle" class="nav-toggle" aria-label="切换菜单" aria-expanded="false" aria-controls="navbarMenu">
                <span></span><span></span><span></span>
            </button>
            <ul class="navbar-menu" id="navbarMenu">
                {% if logged_in %}
                <li><a href="/dashboard" {% if request.path == '/dashboard' %}class="active"{% endif %}>仪表板</a></li>
                <li><a href="/chat" {% if request.path == '/chat' %}class="active"{% endif %}>AI 对话</a></li>
                <li><a href="/scheduled-actions" {% if request.path == '/scheduled-actions' %}class="active"{% endif %}>定时任务</a></li>
                <li><a href="/results" {% if request.path == '/results' %}class="active"{% endif %}>执行记录</a></li>
                <li><a href="/settings" {% if request.path == '/settings' %}class="active"{% endif %}>设置</a></li>
                <li class="nav-uuid">{{ display_name or user_email or session_client_uuid }}</li>
                <li>
                    <form method="post" action="{{ url_for('main.logout') }}" class="logout-form">
                        <button type="submit" class="btn btn-secondary btn-nav">退出</button>
                    </form>
                </li>
                {% else %}
                <li><a href="{{ url_for('main.login') }}">登录</a></li>
                <li><a href="{{ url_for('main.register') }}">注册</a></li>
                {% endif %}
                <li>
                    <button type="button" id="darkModeToggle" class="btn btn-nav dark-mode-toggle" title="切换暗黑模式" aria-label="切换暗黑模式">🌙</button>
                </li>
            </ul>
        </div>
    </nav>

    <main class="container">
        {% with messages = get_flashed_messages(with_categories=true) %}
            {% if messages %}
                {% for category, message in messages %}
                    <div class="alert alert-{{ category }} alert-auto-dismiss">
                        {{ message }}
                    </div>
                {% endfor %}
            {% endif %}
        {% endwith %}

        {% block content %}{% endblock %}
    </main>

    <footer>
        <p>&copy; 2026 Nola. All rights reserved.</p>
    </footer>

    <script src="{{ url_for('static', filename='js/main.js') }}"></script>
    <script>
    (function() {
        var KEY = 'nola_theme';
        var root = document.documentElement;
        function apply(theme) {
            if (theme === 'dark') {
                root.setAttribute('data-theme', 'dark');
            } else {
                root.removeAttribute('data-theme');
            }
            window.dispatchEvent(new Event('nola-theme-change'));
            var btn = document.getElementById('darkModeToggle');
            var btnMobile = document.getElementById('darkModeToggleMobile');
            if (btn) btn.textContent = (theme === 'dark') ? '☀️' : '🌙';
            if (btnMobile) btnMobile.textContent = (theme === 'dark') ? '☀️' : '🌙';
            // Sync iOS Safari status bar color
            var metas = document.querySelectorAll('meta[name="theme-color"]');
            metas.forEach(function(m) { m.removeAttribute('media'); });
            if (metas.length) {
                metas[0].setAttribute('content', theme === 'dark' ? '#141414' : '#ffffff');
                for (var i = 1; i < metas.length; i++) metas[i].remove();
            }
        }
        function toggleTheme() {
            var next = (localStorage.getItem(KEY) === 'dark') ? 'light' : 'dark';
            localStorage.setItem(KEY, next);
            apply(next);
        }
        document.addEventListener('DOMContentLoaded', function() {
            var cur = localStorage.getItem(KEY) === 'dark' ? 'dark' : 'light';
            apply(cur);
            var btn = document.getElementById('darkModeToggle');
            var btnMobile = document.getElementById('darkModeToggleMobile');
            if (btn) {
                btn.addEventListener('click', toggleTheme);
            }
            if (btnMobile) {
                btnMobile.addEventListener('click', toggleTheme);
            }
            // Mobile hamburger toggle
            var navToggle = document.getElementById('navToggle');
            var navMenu = document.getElementById('navbarMenu');
            if (navToggle && navMenu) {
                navToggle.addEventListener('click', function() {
                    var open = navMenu.classList.toggle('is-open');
                    navToggle.setAttribute('aria-expanded', open ? 'true' : 'false');
                    navToggle.classList.toggle('is-active', open);
                });
                // Close menu when a link/button inside it is tapped
                navMenu.addEventListener('click', function(e) {
                    var t = e.target;
                    if (t.tagName === 'A' || t.tagName === 'BUTTON') {
                        navMenu.classList.remove('is-open');
                        navToggle.classList.remove('is-active');
                        navToggle.setAttribute('aria-expanded', 'false');
                    }
                });
            }
        });
    })();
    </script>
    {% block extra_js %}{% endblock %}
</body>
</html>
