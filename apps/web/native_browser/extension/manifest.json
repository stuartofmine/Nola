{
  "manifest_version": 3,
  "name": "Nola Native Browser Bridge",
  "description": "Lets the local Nola Web Agent operate the user's real Chrome tabs through Native Messaging.",
  "version": "0.4.0",
  "key": "",
  "action": {
    "default_title": "Connect Nola",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "activeTab",
    "debugger",
    "nativeMessaging",
    "scripting",
    "storage",
    "tabs",
    "webNavigation"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ]
}
