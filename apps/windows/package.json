{
  "name": "nola-windows",
  "version": "2.0.0",
  "private": true,
  "description": "Tauri desktop client for the Nola Web Host on Windows",
  "scripts": {
    "build": "tauri build --no-bundle",
    "build:web": "npm --prefix ../web/frontend ci && npm --prefix ../web/frontend run build",
    "dev": "tauri dev",
    "native:x64:cpu": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/build-native.ps1 -Architecture x64 -Backend cpu",
    "native:x64:vulkan": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/build-native.ps1 -Architecture x64 -Backend vulkan",
    "native:x64:cuda": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/build-native.ps1 -Architecture x64 -Backend cuda",
    "native:arm64:cpu": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/build-native.ps1 -Architecture arm64 -Backend cpu",
    "stage:native:x64": "node scripts/stage-native.mjs --arch x64",
    "stage:native:arm64": "node scripts/stage-native.mjs --arch arm64",
    "dist:x64": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/tauri-dist.ps1 -Architecture x64 -Backend cpu",
    "dist:x64:vulkan": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/tauri-dist.ps1 -Architecture x64 -Backend vulkan",
    "dist:x64:cuda": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/tauri-dist.ps1 -Architecture x64 -Backend cuda",
    "dist:arm64": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/tauri-dist.ps1 -Architecture arm64 -Backend cpu",
    "test": "npm run test:unit && npx playwright test --project=chromium-desktop-shell",
    "test:e2e": "powershell.exe -STA -NoProfile -ExecutionPolicy Bypass -File scripts/test-installed-ui.ps1",
    "pretest:unit": "tsc -p tsconfig.json",
    "test:unit": "node --test unit/*.test.cjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@tauri-apps/cli": "^2.12.6",
    "@types/node": "^24.0.0",
    "typescript": "^7.0.2"
  }
}
