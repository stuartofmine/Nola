# Nola backend env template (CN node)

# ----- Core gateway -----
GUNICORN_CAPTURE_OUTPUT=0
GUNICORN_LOGGER_CLASS=app.gunicorn_logger.NolaGunicornLogger

GATEWAY_LOG_LEVEL=INFO
GATEWAY_BUILD_ID=nola-gateway-cn
GATEWAY_DEBUG_LOGS=false
ENABLE_REQUEST_DEBUG=false

# CN node preferred upstream
TARGET_OPENAI_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
TARGET_OPENAI_API_KEY=REPLACE_ME
MODEL=qwen-plus
SMALL_MODEL=qwen-turbo
FORCE_DEFAULT_MODEL=true

DATABASE_URL=postgresql+psycopg2://nola_user:REPLACE_ME@127.0.0.1:5432/nola_cn

DEFAULT_MONTHLY_TOKEN_LIMIT=1000000
SUBSCRIPTION_MONTHLY_TOKEN_LIMIT=1000000
SUBSCRIPTION_PRODUCT_IDS=com.nola.sub
PRO_PRODUCT_IDS=com.nola.pro

UPSTREAM_AUTH_HEADER=Authorization
UPSTREAM_AUTH_SCHEME=Bearer
UPSTREAM_PASSTHROUGH_AUTH=false
UPSTREAM_STREAM_READ_TIMEOUT=25
MAX_REQUEST_BODY_BYTES=2097152

DISABLE_PURCHASE_CHECK=false
ADMIN_API_KEY=REPLACE_ME

# ----- Purchases / StoreKit test -----
APPLE_SHARED_SECRET=REPLACE_ME
ALLOW_LOCAL_STOREKIT_TESTS=false
LOCAL_TEST_TOKEN=REPLACE_ME

# ----- Region routing -----
REGION_ID=cn-ali-1
REGION_BASE_CN=https://api-cn.example.com
REGION_BASE_GLOBAL=https://api-global.example.com
REGION_FORWARD_TIMEOUT=30
REGION_STREAM_READ_TIMEOUT=30

# ----- Outbox replication -----
OUTBOX_SYNC_ENABLED=true

# Shared cross-region Redis (NOT localhost in production)
REDIS_URL=redis://REPLACE_REDIS_HOST:6379/0
OUTBOX_SIGNING_KEY=REPLACE_ME

REDIS_STREAM_KEY=nola:outbox
REDIS_DLQ_STREAM=
REDIS_GROUP=
# REDIS_GROUP default => nola-sync-cn-ali-1
# REDIS_DLQ_STREAM default => nola:outbox:dlq:cn-ali-1

OUTBOX_PUBLISH_ENABLED=true
OUTBOX_CONSUME_ENABLED=true
OUTBOX_PUBLISH_LOCK_KEY=
OUTBOX_PUBLISH_LOCK_TTL_SEC=120
# OUTBOX_PUBLISH_LOCK_KEY default => nola:outbox:publisher-lock:cn-ali-1

SYNC_PUBLISH_INTERVAL_SEC=60
SYNC_CONSUME_BLOCK_MS=5000
SYNC_BATCH_LIMIT=100

OUTBOX_DLQ_REPLAY_ENABLED=false
OUTBOX_DLQ_REPLAY_INTERVAL_SEC=60
OUTBOX_DLQ_REPLAY_BATCH=100

# ----- Push / scheduled actions -----
PUSH_FEATURE_ENABLED=true
PUSH_SCHEDULER_ENABLED=true
PUSH_SCHEDULER_LOCK_KEY=
PUSH_SCHEDULER_LOCK_TTL_SEC=30
PUSH_SCHEDULER_RETRY_INTERVAL_SEC=5
# PUSH_SCHEDULER_LOCK_KEY default => nola:push:scheduler-lock:cn-ali-1

PUSH_DELIVERY_MODE=alert
PUSH_RESULT_TTL_DAYS=3
PUSH_VISIBLE_FALLBACK_GRACE_MIN=10
PUSH_EXECUTE_LEAD_MIN=5
PUSH_MAX_SOURCES=10
PUSH_MAX_FETCH_BYTES=1048576
PUSH_MAX_REDIRECTS=3
PUSH_LLM_MAX_OUTPUT_TOKENS=800
PUSH_TOKEN_ESTIMATE_SAFETY_MULT=1.2

APNS_TEAM_ID=REPLACE_ME
APNS_KEY_ID=REPLACE_ME
APNS_TOPIC=com.gaojc.Nola
APNS_AUTH_KEY_P8=
APNS_AUTH_KEY_P8_FILE=/root/key/AuthKey_xxx.p8
APNS_USE_SANDBOX=false

DEBUG_ADMIN_TOKEN=REPLACE_ME
SERVER_JWT_SECRET=REPLACE_ME
SERVER_JWT_ISSUER=nola
SERVER_JWT_TTL_SEC=86400

# Purchase reverify singleton lock (distributed)
PURCHASES_REVERIFY_LOCK_KEY=
PURCHASES_REVERIFY_LOCK_TTL_SEC=900
# PURCHASES_REVERIFY_LOCK_KEY default => nola:purchases:reverify-lock:cn-ali-1

# ----- Optional retrieval -----
SERPER_API_KEY=REPLACE_ME
