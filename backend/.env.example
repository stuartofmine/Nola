# Nola backend configuration is loaded only from the nola_backend_env JSON
# environment variable. backend/.env is not read.
#
# Local shell example:
#   source backend/.env.example
#
# Cloudflare example:
#   Set variable name: nola_backend_env
#   Set variable value: the JSON object inside the quotes below.

export nola_backend_env='{
  "DATABASE_URL": "postgresql+psycopg2://user:pass@host:5432/nola",
  "GATEWAY_LOG_LEVEL": "INFO",
  "GATEWAY_BUILD_ID": "nola-gateway-prod",
  "GATEWAY_DEBUG_LOGS": false,
  "ENABLE_API_DOCS": false,
  "SCAN_GUARD_ENABLED": true,
  "SCAN_GUARD_UNKNOWN_PATH_LIMIT_PER_MIN": 60,
  "SCAN_GUARD_BAN_SECONDS": 300,

  "TARGET_OPENAI_API_BASE": "https://api.openai.com/v1",
  "TARGET_OPENAI_API_KEY": "sk-REPLACE_ME",
  "MODEL": "gpt-4o-mini",
  "SMALL_MODEL": "gpt-4o-mini",
  "FORCE_DEFAULT_MODEL": false,
  "DEFAULT_MONTHLY_TOKEN_LIMIT": 100000,
  "SUBSCRIPTION_MONTHLY_TOKEN_LIMIT": 100000,
  "SUBSCRIPTION_PRODUCT_IDS": "com.nola.sub",
  "PRO_PRODUCT_IDS": "com.nola.pro",
  "UPSTREAM_AUTH_HEADER": "Authorization",
  "UPSTREAM_AUTH_SCHEME": "Bearer",
  "UPSTREAM_PASSTHROUGH_AUTH": false,
  "UPSTREAM_STREAM_READ_TIMEOUT": 25,
  "MAX_REQUEST_BODY_BYTES": 2097152,
  "DISABLE_PURCHASE_CHECK": false,

  "REGION_ID": "cn",
  "REGION_BASE_CN": "https://api-cn.example.com",
  "REGION_BASE_GLOBAL": "https://api.example.com",
  "REGION_FORWARD_TIMEOUT": 30,

  "REDIS_URL": "redis://localhost:6379/0",
  "OUTBOX_SIGNING_KEY": "REPLACE_ME",
  "OUTBOX_PUBLISH_ENABLED": true,
  "OUTBOX_CONSUME_ENABLED": true,

  "PUSH_FEATURE_ENABLED": false,
  "PUSH_SCHEDULER_ENABLED": false,
  "PUSH_DELIVERY_MODE": "alert",
  "PUSH_RUN_NOW_WAIT_SECONDS": 20,
  "APNS_TEAM_ID": "REPLACE_ME",
  "APNS_KEY_ID": "REPLACE_ME",
  "APNS_TOPIC": "com.example.app",
  "APNS_AUTH_KEY_P8": "",
  "APNS_AUTH_KEY_P8_FILE": "/path/to/AuthKey.p8",
  "APNS_USE_SANDBOX": true,

  "DEBUG_ADMIN_TOKEN": "REPLACE_ME",
  "ADMIN_API_KEY": "REPLACE_ME",
  "SERVER_JWT_SECRET": "REPLACE_ME",
  "SERVER_JWT_ISSUER": "nola",
  "SERVER_JWT_TTL_SEC": 0,

  "OAUTH_RELAY_PUBLIC_BASE_URL": "https://your-api.example.com",
  "OAUTH_RELAY_ALLOWED_REDIRECT_HOSTS": "127.0.0.1,localhost",
  "APPLE_SIGNIN_CLIENT_ID": "com.nola.auth.apple",
  "APPLE_SIGNIN_AUD": "com.nola.auth.apple",
  "APPLE_SIGNIN_AUDS": "com.gaojc.Nola,com.nola.auth.apple",
  "GOOGLE_OAUTH_CLIENT_ID": "REPLACE_ME",
  "GOOGLE_OAUTH_CLIENT_SECRET": "REPLACE_ME",
  "GITHUB_OAUTH_CLIENT_ID": "REPLACE_ME",
  "GITHUB_OAUTH_CLIENT_SECRET": "REPLACE_ME",

  "APPLE_SHARED_SECRET": "",
  "ALLOW_LOCAL_STOREKIT_TESTS": false,
  "LOCAL_TEST_TOKEN": "",
  "PRODUCT_PRICE_CATALOG_JSON": {},
  "STRIPE_SECRET_KEY": "",
  "STRIPE_PRICE_MAP_JSON": {},
  "STRIPE_WEBHOOK_SECRET": "",
  "SERPER_API_KEY": ""
}'
