{
  "name": "nola-worker",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test:scheduler:e2e": "../../scripts/test_worker_scheduler_e2e.sh",
    "test:channels": "python3 ../../scripts/test_messaging_webhooks_e2e.py",
    "test:channels:real": "NOLA_RUN_REAL_MESSAGING_LLM_E2E=1 python3 ../../scripts/test_messaging_channels_real_llm_e2e.py",
    "migrate:local": "wrangler d1 migrations apply nola_backend_fresh --local",
    "migrate:remote": "wrangler d1 migrations apply nola_backend_fresh --remote"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260510.0",
    "typescript": "^5.9.3",
    "wrangler": "^4.46.0"
  }
}
